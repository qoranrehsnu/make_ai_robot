<?xml version="1.0" ?>

<sdf version="1.6">
  <world name="default">

    <!-- Plugin for simulating physics -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <!-- Plugin for handling user commands -->
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <!-- Plugin for broadcasting scene updates -->
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- Plugin for handling sensors like the LIDAR -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Plugin for IMU -->
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <!-- To add realistic gravity, do: 0.0 0.0 -9.8, otherwise do 0.0 0.0 0.0 -->
    <gravity>0.0 0.0 -9.8</gravity>    

     <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Include a model of the Ground Plane from an external URI -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane
      </uri>
    </include>


      <!-- ===== OBJECTS (random positions within -1.5 ~ 1.5m, avoid robot spawn x=-1,y=0) ===== -->

    <!-- apple_good (dish + apple) -->
    <model name="dish_apple_good">
      <include>
        <uri>model://WhiteDish</uri>
        <static>true</static>
        <pose>1.335 -0.133 0.20 0 0 0</pose>
      </include>
    </model>

    <model name="apple_good">
      <include>
        <uri>model://AppleGood</uri>
        <static>true</static>
        <pose>1.335 -0.133 0.25 0 0 0</pose>
      </include>
    </model>

    <!-- banana_good (dish + banana) -->
    <model name="dish_banana_good">
      <include>
        <uri>model://WhiteDish</uri>
        <static>true</static>
        <pose>0.150 0.673 0.20 0 0 0</pose>
      </include>
    </model>

    <model name="banana_good">
      <include>
        <uri>model://BananaGood</uri>
        <static>true</static>
        <pose>0.150 0.673 0.25 0 0 0</pose>
      </include>
    </model>

    <!-- pizza_good (dish + pizza) -->
    <model name="dish_pizza_good">
      <include>
        <uri>model://WhiteDish</uri>
        <static>true</static>
        <pose>1.052 0.508 0.20 0 0 0</pose>
      </include>
    </model>

    <model name="pizza_good">
      <include>
        <uri>model://PizzaGood</uri>
        <static>true</static>
        <pose>1.052 0.508 0.25 0 0 0</pose>
      </include>
    </model>

    <!-- apple_bad (dish + apple_bad) -->
    <model name="dish_apple_bad">
      <include>
        <uri>model://WhiteDish</uri>
        <static>true</static>
        <pose>1.011 -0.423 0.20 0 0 0</pose>
      </include>
    </model>

    <model name="apple_bad">
      <include>
        <uri>model://AppleBad</uri>
        <static>true</static>
        <pose>1.011 -0.423 0.25 0 0 0</pose>
      </include>
    </model>

    <!-- banana_bad (dish + banana_bad) -->
    <model name="dish_banana_bad">
      <include>
        <uri>model://WhiteDish</uri>
        <static>true</static>
        <pose>-0.077 0.314 0.20 0 0 0</pose>
      </include>
    </model>

    <model name="banana_bad">
      <include>
        <uri>model://BananaBad</uri>
        <static>true</static>
        <pose>-0.077 0.314 0.25 0 0 0</pose>
      </include>
    </model>

    <!-- pizza_bad (dish + pizza_bad) -->
    <model name="dish_pizza_bad">
      <include>
        <uri>model://WhiteDish</uri>
        <static>true</static>
        <pose>0.121 -1.254 0.20 0 0 0</pose>
      </include>
    </model>

    <model name="pizza_bad">
      <include>
        <uri>model://PizzaBad</uri>
        <static>true</static>
        <pose>0.121 -1.254 0.25 0 0 0</pose>
      </include>
    </model>

    <!-- toilet -->
    <model name="toilet_1">
      <include>
        <uri>model://Toilet</uri>
        <static>true</static>
        <pose>-0.492 -1.002 0.0 0 0 0</pose>
      </include>
    </model>

    <!-- nurse -->
    <model name="nurse_1">
      <include>
        <uri>model://Scrubs</uri>
        <static>true</static>
        <pose>-0.818 1.259 0.0 0 0 0</pose>
      </include>
    </model>

    <!-- cones -->
    <model name="cone_red_1">
      <include>
        <uri>model://red_cone</uri>
        <static>true</static>
        <pose>1.344 1.395 0 0 0 0</pose>
      </include>
    </model>

    <model name="cone_blue_1">
      <include>
        <uri>model://blue_cone</uri>
        <static>true</static>
        <pose>-0.861 -1.293 0 0 0 0</pose>
      </include>
    </model>

    <model name="cone_green_1">
      <include>
        <uri>model://green_cone</uri>
        <static>true</static>
        <pose>0.809 0.163 0 0 0 0</pose>
      </include>
    </model>

    <!-- box -->
    <model name="box_1">
      <include>
        <uri>model://box</uri>
        <static>false</static>
        <pose>0.790 0.929 0.5 0 0 0</pose>
      </include>
    </model>

    <!-- tile_red -->
    <model name="tile_red">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 0.5 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
      <pose>-1.337 1.201 -0.025 0 0 0</pose>
    </model>

    <!-- stop_sign -->
    <model name="stop_sign_1">
      <include>
        <uri>model://circle_sign</uri>
        <static>true</static>
        <pose>0.495 -0.609 0.0 0 0 0</pose>
      </include>
    </model>




  </world>
</sdf>
